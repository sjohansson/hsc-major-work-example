root = true

# Default settings for all files
[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{css,scss,sass}]
indent_style = space
indent_size = 2

[*.{html, xml}]
indent_style = space
indent_size = 2

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# Markdown: trailing double spaces are hard line breaks
[*.{md,markdown}]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = space
indent_size = 2

# no extra line at the end of the node spec
[*.node-version]
insert_final_newline = false

[*.ps1]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

