root = true

# Default settings for all files
[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Special settings for Markdown files
[*.{md,markdown,mdx,handlebars,hbs}]
trim_trailing_whitespace = false  # Don't trim spaces in markdown lists, code blocks, etc.
insert_final_newline = false  # Don't add an extra newline at the end of context sensitive files

# Settings for JSON and YAML files
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Optional: for CSS/SASS/SCSS
[*.{css,scss,sass}]
indent_style = space
indent_size = 2

# Optional: for JavaScript/TypeScript
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# no extra line at the end of the node spec
[*.node-version]
insert_final_newline = false
