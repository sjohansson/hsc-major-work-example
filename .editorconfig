root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown: trailing double spaces are hard line breaks
[*.{md,markdown}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{json,jsonc,yml,yaml,css,html,js}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.ps1]
indent_size = 4
