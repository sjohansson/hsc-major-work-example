# VS Code: keep only the shared workspace files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Python
__pycache__/
*.pyc
.venv/

# Generated output (Canva export, PDFs, verify diffs, previews)
/build/

# Canva account identifiers (design id, page ids, asset ids)
/canva.local.json

# The fixture deck builds into its own folder when run in place.
/.agents/skills/canva-sync/assets/fixtures/mini-deck/build/
