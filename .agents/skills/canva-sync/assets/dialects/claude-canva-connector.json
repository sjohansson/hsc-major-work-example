{
  "name": "claude-canva-connector",
  "status": "verified",
  "description": "Canva's MCP connector as it is exposed today (checked 26 September 2026 through the claude.ai Canva connector): read-design opens an editing transaction and reads pages, edit-design applies operations to one page per call and commits or cancels. It creates shapes, images, text and pages, formats text and replaces speaker notes. Elements are addressed by locator id (page id, a hyphen, element id). Verified 26 September 2026: page 01 pushed (69 element and 25 format operations), read back and committed to design DAHWPUeQnIU.",
  "required_tools": ["read-design", "edit-design"],
  "apply_tool": "edit-design",
  "transaction": {
    "open": "read-design with open_transaction: true; the response carries transaction_id",
    "apply": "edit-design with transaction_id, page_index (1-based) and operations, finalize: keep_open",
    "commit": "edit-design with transaction_id and finalize: commit, no operations, only after the person approves the preview",
    "cancel": "edit-design with transaction_id and finalize: cancel, no operations"
  },
  "path_commands": "MmLlHhVvCcSsAaZz",
  "capabilities": {
    "create_elements": true,
    "create_pages": true,
    "speaker_notes": true,
    "format_text": true,
    "transactions": true
  },
  "ops": {
    "page": {
      "type": "add_page",
      "emit": [
        ["from", "width", "width"],
        ["from", "height", "height"],
        ["from", "background_color", "background"],
        ["from", "title", "title"]
      ]
    },
    "notes": {
      "type": "replace_speaker_notes",
      "emit": [
        ["from", "page_id", "page"],
        ["from", "notes", "notes"]
      ]
    },
    "shape": {
      "type": "insert_shape",
      "emit": [
        ["from", "page_id", "page"],
        ["from", "top", "top"],
        ["from", "left", "left"],
        ["from", "width", "width"],
        ["from", "height", "height"],
        ["from", "path", "path"],
        ["from", "view_box_width", "view_box_width"],
        ["from", "view_box_height", "view_box_height"],
        ["from", "color", "fill"],
        ["from", "stroke_color", "stroke"],
        ["from", "stroke_weight", "stroke_weight"],
        ["from", "rotation", "rotation"]
      ]
    },
    "image": {
      "type": "insert_fill",
      "emit": [
        ["from", "page_id", "page"],
        ["const", "asset_type", "image"],
        ["from", "asset_id", "asset_id"],
        ["from", "alt_text", "alt_text"],
        ["from", "top", "top"],
        ["from", "left", "left"],
        ["from", "width", "width"],
        ["from", "height", "height"]
      ]
    },
    "text": {
      "type": "add_text",
      "emit": [
        ["from", "page_id", "page"],
        ["from", "text", "text"],
        ["from", "top", "top"],
        ["from", "left", "left"],
        ["from", "width", "width"],
        ["from", "rotation", "rotation"]
      ]
    },
    "format": {
      "type": "format_text",
      "emit": [
        ["from", "locator_id", "locator_id"],
        ["nest", "formatting", [
          ["from", "font_size", "font_size"],
          ["from", "color", "color"],
          ["from", "text_align", "text_align"],
          ["from", "line_height", "line_height"],
          ["from", "font_weight", "font_weight"],
          ["from", "font_style", "font_style"]
        ]]
      ]
    }
  }
}
