{
  // CLI and CI configuration. Keep the rules in step with .markdownlint.jsonc,
  // which the VS Code extension reads for live feedback.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false
  },
  "ignores": [
    "build/**",
    ".venv/**",
    "node_modules/**"
  ]
}
